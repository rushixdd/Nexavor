{
  "$schema": "http://json.schemastore.org/template",
  "author": "Nexavor",
  "classifications": ["Microservices", "Distributed Systems", "Cloud"],
  "identity": "Nexavor.Templates.Ecosystem",
  "name": "Micro-services Ecosystem",
  "shortName": "ecosystem",
  "sourceName": "EcosystemName",
  "preferNameDirectory": true,
  "symbols": {
    "services": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "user,order,payment,notification",
      "description": "Comma-separated service names"
    },
    "architecture": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [{"choice":"clean"},{"choice":"minimal"}],
      "defaultValue": "clean",
      "description": "Service architecture style"
    },
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [{"choice":"sqlserver"},{"choice":"postgres"}],
      "defaultValue": "postgres",
      "description": "Primary database flavor"
    },
    "frontend": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {"choice":"react"},
        {"choice":"angular"},
        {"choice":"nextjs"},
        {"choice":"none"}
      ],
      "defaultValue": "react"
    },
    "infra": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "docker,k8s,monitoring,logging",
      "description": "Comma-separated infra features"
    },
    "gateway": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [{"choice":"yarp"},{"choice":"ocelot"}],
      "defaultValue": "yarp"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [{"choice":"jwt"},{"choice":"identity"}],
      "defaultValue": "jwt"
    },
    "skipRootSolution": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Skip generating the optional root solution file"
    }
  },
  "sources": [
    {
      "source": "content",
      "target": "./",
      "modifiers": [
        {
          "condition": "(frontend == \"none\")",
          "exclude": ["frontend/**"]
        },
        {
          "condition": "(skipRootSolution)",
          "exclude": ["EcosystemName.sln"]
        }
      ]
    }
  ],
  "postActions": [
    {
      "condition": "(!skipRootSolution)",
      "description": "Create root solution placeholder",
      "manualInstructions": [
        {
          "text": "Run 'dotnet sln EcosystemName.sln add backend/MyApp.Backend.sln' after generating service projects."
        }
      ],
      "continueOnError": true
    }
  ],
  "primaryOutputs": [
    {"path": "README.md"},
    {"path": "backend/MyApp.Backend.sln"},
    {"path": "infra/docker-compose.yml"}
  ]
}
